# AI Provider (choose one or use mock mode)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Development Mode (set to true to skip API calls and use deterministic responses)
# MOCK_LLM=true

# Node Environment
NODE_ENV=development

# Audit Log Storage
# Development: Uses filesystem (data/audit-logs/) by default
# Production (Vercel): Auto-configured by Neon Postgres
# Optional: Force filesystem storage even with database URL
# FORCE_FILE_STORAGE=true

# Neon Postgres (Auto-configured in production)
# These are set automatically when you add Neon from Vercel Marketplace
# DATABASE_URL="postgres://..."  # Primary connection string (pooled)
# POSTGRES_URL="postgres://..."  # Alternative (backward compatibility)
